{
  "manifest_version": 3,
  "name": "Chrome Cruiser",
  "version": "1.1",
  "description": "Drive a car around your webpages!",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": "car_icon.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/car1.png", "images/car2.png", "images/car3.png"],
      "matches": ["https://www.google.com/*"]
    }
  ]
}
